# Kopieer naar .env en vul in. .env is gitignored.

# NCBI E-utilities — key is gratis (account -> Settings -> API Key Management).
# Zonder key: 3 req/s. Met key: 10 req/s.
NCBI_API_KEY=
# Verplicht beleefdheidsveld van NCBI: identificeer jezelf.
NCBI_EMAIL=jouw@email.be
NCBI_TOOL=nerve-lit

# Unpaywall vereist een email-parameter bij elke call (geen key).
UNPAYWALL_EMAIL=jouw@email.be

# Waar de full-text landt. Moet de Google-Drive-gesyncte map van de JUISTE account
# zijn. Google Drive for Desktop geeft elke account een eigen driveletter; check met
#   Get-PSDrive -PSProvider FileSystem | Select-Object Name, Description
# De Description toont het e-mailadres per letter.
PDF_DIR=H:\My Drive\nerve-lit-pdfs

# Lokale data (metadata-DB + LanceDB-index). Gitignored, herbouwbaar.
DATA_DIR=data
